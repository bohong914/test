<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- 請根據您的 SQL Server 實例名稱調整 Data Source (例如 localhost, .\SQLEXPRESS 等) -->
    <add name="SmartCardDBConn" 
         connectionString="Data Source=BAYMAXHONG\SQLEXPRESS;Initial Catalog=SmartCardDB;Integrated Security=True;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <!-- 設定最大上傳限制 10MB (10240 KB) -->
    <httpRuntime targetFramework="4.7.2" maxRequestLength="10240" />
    <sessionState mode="InProc" timeout="60" />
  </system.web>
</configuration>
